{
  "name": "staleproof",
  "version": "0.6.1",
  "description": "An agent that keeps your docs true to your code: it walks a FalkorDB graph of code, docs and decisions across repositories, runs the examples, and proposes the docs fix with the path behind each paragraph.",
  "license": "MIT",
  "author": "Raj Karia",
  "homepage": "https://github.com/rajkaria/staleproof#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rajkaria/staleproof.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "staleproof": "dist/cli.js"
  },
  "files": [
    "dist",
    "web/dist",
    "grammars",
    "python",
    "scripts/falkordb-local.sh",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && vite build web && npm run prerender",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run test",
    "dev": "tsx src/cli.ts",
    "db:start": "bash scripts/falkordb-local.sh start",
    "db:stop": "bash scripts/falkordb-local.sh stop",
    "build:web": "vite build web && npm run prerender",
    "prerender": "tsx --tsconfig web/tsconfig.json scripts/prerender.ts",
    "serve": "tsx src/cli.ts serve",
    "docs": "tsx scripts/gen-docs.ts",
    "snapshot": "tsx scripts/snapshot.ts"
  },
  "keywords": [
    "docs",
    "documentation",
    "drift",
    "falkordb",
    "graph",
    "agent",
    "mcp",
    "code-graph"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@vercel/functions": "^3.9.11",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "falkordb": "^6.8.0",
    "hono": "^4.13.13",
    "smol-toml": "^1.9.1",
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15",
    "web-tree-sitter": "^0.27.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^26.1.0",
    "marked": "^15.0.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
